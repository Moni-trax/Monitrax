{
  "info": {
    "name": "Monitrax API",
    "_postman_id": "monitrax-collection-v2",
    "description": "Monitrax backend API — health check, system metrics, uptime/API monitors, and Docker endpoints.\n\nSet the `baseUrl` collection variable to change the target server (default: http://localhost:4000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string",
      "description": "Base URL of the Monitrax backend server"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns { status: 'ok', uptime: <seconds> }."
          },
          "response": [
            {
              "name": "200 OK — Server running",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"ok\",\n  \"uptime\": 42.35\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Metrics",
      "item": [
        {
          "name": "Current Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics"]
            },
            "description": "Returns a fresh metrics snapshot collected at request time."
          },
          "response": [
            {
              "name": "200 OK — Current snapshot",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2026-10-03T08:55:00.000Z\",\n  \"hostname\": \"my-machine\",\n  \"cpu\": {\n    \"usagePercent\": 12.45,\n    \"cores\": 8,\n    \"perCore\": [10.2, 14.7]\n  },\n  \"ram\": {\n    \"totalBytes\": 17179869184,\n    \"usedBytes\": 8589934592,\n    \"freeBytes\": 8589934592,\n    \"usagePercent\": 50.0\n  },\n  \"disk\": [\n    {\n      \"mount\": \"/\",\n      \"totalBytes\": 499963174912,\n      \"usedBytes\": 249981587456,\n      \"usagePercent\": 50.0\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Metrics History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "history"]
            },
            "description": "Returns the last N snapshots from the in-memory ring buffer."
          },
          "response": [
            {
              "name": "200 OK — History",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"count\": 1,\n  \"snapshots\": []\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Monitors",
      "item": [
        {
          "name": "List Monitors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitors"]
            },
            "description": "Returns all configured monitors with computed status, uptime %, and latency stats."
          },
          "response": [
            {
              "name": "200 OK — List monitors",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"id\": \"c6bfb9d4-6f4e-4b2a-a92c-5b23d90f2345\",\n    \"name\": \"Google Healthcheck\",\n    \"url\": \"https://www.google.com\",\n    \"method\": \"GET\",\n    \"expectedStatus\": 200,\n    \"intervalSec\": 30,\n    \"timeoutMs\": 5000,\n    \"headers\": {},\n    \"body\": null,\n    \"state\": \"up\",\n    \"uptimePercent\": 100,\n    \"avgResponseTimeMs\": 64,\n    \"lastResponseTimeMs\": 58,\n    \"lastChecked\": \"2026-10-20T10:45:00.000Z\",\n    \"lastError\": null,\n    \"recentResults\": []\n  }\n]"
            }
          ]
        },
        {
          "name": "Create Monitor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Production API Health\",\n  \"url\": \"https://httpbin.org/status/200\",\n  \"method\": \"GET\",\n  \"expectedStatus\": 200,\n  \"intervalSec\": 30,\n  \"timeoutMs\": 5000,\n  \"headers\": {},\n  \"body\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/monitors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitors"]
            },
            "description": "Creates a new HTTP/HTTPS monitor and starts scheduler."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"c6bfb9d4-6f4e-4b2a-a92c-5b23d90f2345\",\n  \"name\": \"Production API Health\",\n  \"url\": \"https://httpbin.org/status/200\",\n  \"method\": \"GET\",\n  \"expectedStatus\": 200,\n  \"intervalSec\": 30,\n  \"timeoutMs\": 5000,\n  \"headers\": {},\n  \"body\": null,\n  \"createdAt\": \"2026-10-20T10:45:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Update Monitor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Production API Health Updated\",\n  \"intervalSec\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/monitors/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitors", ":id"],
              "variable": [{ "key": "id", "value": "c6bfb9d4-6f4e-4b2a-a92c-5b23d90f2345" }]
            },
            "description": "Updates monitor properties and reschedules the interval."
          },
          "response": [
            {
              "name": "200 OK — Updated",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"c6bfb9d4-6f4e-4b2a-a92c-5b23d90f2345\",\n  \"name\": \"Production API Health Updated\",\n  \"url\": \"https://httpbin.org/status/200\",\n  \"method\": \"GET\",\n  \"expectedStatus\": 200,\n  \"intervalSec\": 15,\n  \"timeoutMs\": 5000\n}"
            }
          ]
        },
        {
          "name": "Delete Monitor",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitors", ":id"],
              "variable": [{ "key": "id", "value": "c6bfb9d4-6f4e-4b2a-a92c-5b23d90f2345" }]
            },
            "description": "Stops scheduler and removes monitor."
          },
          "response": [
            {
              "name": "200 OK — Deleted",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Monitor deleted successfully\",\n  \"id\": \"c6bfb9d4-6f4e-4b2a-a92c-5b23d90f2345\"\n}"
            }
          ]
        },
        {
          "name": "Monitor History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors/:id/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitors", ":id", "history"],
              "variable": [{ "key": "id", "value": "c6bfb9d4-6f4e-4b2a-a92c-5b23d90f2345" }]
            },
            "description": "Returns the last 100 check executions for the monitor."
          },
          "response": [
            {
              "name": "200 OK — History",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"monitorId\": \"c6bfb9d4-6f4e-4b2a-a92c-5b23d90f2345\",\n  \"count\": 2,\n  \"results\": [\n    {\n      \"ts\": \"2026-10-20T10:45:00.000Z\",\n      \"ok\": true,\n      \"statusCode\": 200,\n      \"responseTimeMs\": 45,\n      \"error\": null\n    }\n  ]\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Docker",
      "item": [
        {
          "name": "Docker Snapshot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/docker",
              "host": ["{{baseUrl}}"],
              "path": ["api", "docker"]
            },
            "description": "Returns current container statuses and resource stats or available: false."
          },
          "response": [
            {
              "name": "200 OK — Docker running",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"available\": true,\n  \"containers\": [\n    {\n      \"id\": \"a1b2c3d4e5f6\",\n      \"name\": \"monitrax-redis\",\n      \"image\": \"redis:7-alpine\",\n      \"state\": \"running\",\n      \"status\": \"Up 2 hours\",\n      \"startedAt\": \"2026-10-20T08:00:00.000Z\",\n      \"cpuPercent\": 0.12,\n      \"memUsageBytes\": 14680064,\n      \"memLimitBytes\": 8388608000,\n      \"memPercent\": 0.18,\n      \"netRxBytes\": 1024,\n      \"netTxBytes\": 2048\n    }\n  ],\n  \"timestamp\": \"2026-10-20T10:45:00.000Z\"\n}"
            },
            {
              "name": "200 OK — Docker unavailable",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"available\": false,\n  \"containers\": []\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Anomalies",
      "item": [
        {
          "name": "List Anomalies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/anomalies?status=all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "anomalies"],
              "query": [{ "key": "status", "value": "all" }]
            },
            "description": "Returns anomalies list filtered by status: open, resolved, or all."
          },
          "response": [
            {
              "name": "200 OK — List Anomalies",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"id\": \"e4f8b9d1-321a-4c91-a12b-34567890abcd\",\n    \"series\": \"cpu_usage_percent\",\n    \"kind\": \"threshold\",\n    \"severity\": \"critical\",\n    \"value\": 94.2,\n    \"baselineMean\": 24.5,\n    \"baselineStd\": 3.1,\n    \"zScore\": 22.48,\n    \"startedAt\": \"2026-10-20T18:00:00.000Z\",\n    \"resolvedAt\": null,\n    \"status\": \"open\",\n    \"message\": \"cpu_usage_percent at 94.2% breached threshold (90%)\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Anomalies Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/anomalies/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "anomalies", "summary"]
            },
            "description": "Returns counts of open, critical, warning, and total anomalies."
          },
          "response": [
            {
              "name": "200 OK — Anomalies Summary",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"open\": 1,\n  \"critical\": 1,\n  \"warning\": 0,\n  \"total\": 5\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Logs",
      "item": [
        {
          "name": "Log Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/logs/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logs", "summary"]
            },
            "description": "Returns per-minute log volume, top error patterns, and new patterns."
          },
          "response": [
            {
              "name": "200 OK — Log Summary",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"perMinute\": [\n    { \"minute\": \"18:00\", \"ERROR\": 0, \"WARN\": 1, \"INFO\": 12, \"DEBUG\": 0 }\n  ],\n  \"topPatterns\": [\n    {\n      \"pattern\": \"FATAL: Connection pool exhausted for tenant <HEX>\",\n      \"count\": 50,\n      \"firstSeen\": \"2026-10-20T18:00:00.000Z\",\n      \"lastSeen\": \"2026-10-20T18:00:05.000Z\",\n      \"sample\": \"FATAL: Connection pool exhausted for tenant 0x8f4c2e\",\n      \"isNew\": true\n    }\n  ],\n  \"newPatterns\": [],\n  \"totalLogs\": 250\n}"
            }
          ]
        },
        {
          "name": "Recent Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/logs/recent?level=ERROR&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logs", "recent"],
              "query": [
                { "key": "level", "value": "ERROR" },
                { "key": "limit", "value": "100" }
              ]
            },
            "description": "Returns recent parsed log lines with optional filtering."
          },
          "response": [
            {
              "name": "200 OK — Recent Logs",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"id\": \"b8a9c2d1-e4f5-4a6b-8c7d-9e0f1a2b3c4d\",\n    \"source\": \"sample.log\",\n    \"level\": \"ERROR\",\n    \"message\": \"Database connection timeout on pool worker #3\",\n    \"raw\": \"[2026-10-20T18:00:00.000Z] [ERROR] Database connection timeout on pool worker #3\",\n    \"timestamp\": \"2026-10-20T18:00:00.000Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Ingest Logs",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"billing-service\",\n  \"lines\": [\n    \"[2026-10-20T18:05:00Z] [INFO] Payment received for invoice 1234\",\n    \"[2026-10-20T18:05:01Z] [ERROR] Card gateway timeout on user 5678\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/logs/ingest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logs", "ingest"]
            },
            "description": "Ingests up to 500 log lines from external sources."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Logs ingested successfully\",\n  \"count\": 2\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Prometheus",
      "item": [
        {
          "name": "Metrics Scrape",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["metrics"]
            },
            "description": "Prometheus text format endpoint for system, monitor, container, anomaly, and log metrics."
          },
          "response": [
            {
              "name": "200 OK — Prometheus Text",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "text/plain; version=0.0.4; charset=utf-8" }],
              "body": "# HELP monitrax_cpu_usage_percent Overall CPU usage percentage\n# TYPE monitrax_cpu_usage_percent gauge\nmonitrax_cpu_usage_percent 14.5\n"
            }
          ]
        }
      ]
    },
    {
      "name": "Dev",
      "item": [
        {
          "name": "Simulate Anomaly",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"series\": \"cpu_usage_percent\",\n  \"value\": 95.0,\n  \"count\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dev/simulate-anomaly",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dev", "simulate-anomaly"]
            },
            "description": "Dev-only endpoint to simulate sustained anomalous data points."
          },
          "response": [
            {
              "name": "200 OK — Simulated",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Simulated 3 points for series cpu_usage_percent with value 95\",\n  \"summary\": { \"open\": 1, \"critical\": 1, \"warning\": 0, \"total\": 1 }\n}"
            }
          ]
        }
      ]
    }
  ]
}

