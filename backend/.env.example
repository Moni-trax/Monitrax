# ── Required ───────────────────────────────────────────────────
# Port the Express server listens on
PORT=4000

# ── Metrics tuning ─────────────────────────────────────────────
# How often (ms) to broadcast a metrics snapshot over WebSocket
METRICS_INTERVAL_MS=1000

# How many snapshots to keep in the in-memory ring buffer
# (accessible via GET /api/metrics/history)
HISTORY_SIZE=300

# ── CORS ───────────────────────────────────────────────────────
# Allowed origin for frontend requests
CORS_ORIGIN=http://localhost:5173

# ── Heartbeat & Polling ────────────────────────────────────────
# How often (ms) to send a heartbeat ping/frame to WebSocket clients
HEARTBEAT_INTERVAL_MS=3000

# How often (ms) to refresh Docker container statistics
DOCKER_INTERVAL_MS=5000

# ── Anomaly Detection ─────────────────────────────────────────
ANOMALY_WINDOW=60
ANOMALY_MIN_SAMPLES=30
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_SUSTAIN=3
ANOMALY_RECOVERY=5
ANOMALY_HISTORY=200
THRESHOLD_CPU=90.0
THRESHOLD_RAM=90.0
THRESHOLD_DISK=90.0

# ── Log Analysis ──────────────────────────────────────────────
# Comma-separated paths to log files to tail
LOG_FILES=./sample.log
LOG_BROADCAST_MS=5000



